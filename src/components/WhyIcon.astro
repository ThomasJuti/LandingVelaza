---
import type { WhyItem } from "../data/whyChooseUs";

interface Props {
  name: WhyItem["icon"];
  size?: number;
}

const { name, size = 22 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="why-icon"
>
  {
    name === "manoCorazon" && (
      <>
        <path d="M12.5 8.6c-1-2-3.6-2.6-5-1-1.3 1.5-1 3.5.6 5l4.4 4 4.4-4c1.6-1.5 1.9-3.5.6-5-1.4-1.6-4-1-5 1z" />
        <path d="M4 15.5l3 2.3c.6.5 1.3.7 2 .7h4.6c.9 0 1.7-.6 1.9-1.5.2-1-.4-1.9-1.4-2.1l-3.6-.8" />
        <path d="M4 14.2h2.4v5.4H4z" />
      </>
    )
  }
  {
    name === "hoja" && (
      <>
        <path d="M4.5 19.5c8-1 13.5-6.7 14.5-15.4-8.6 1-14 6.7-14.5 15.4z" />
        <path d="M6.3 17.7c3-4 6.6-7.5 10.4-10.4" />
      </>
    )
  }
  {
    name === "escudo" && (
      <>
        <path d="M12 3 4.5 5.8v5.4c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V5.8z" />
        <path d="M8.7 12.2l2.2 2.2 4.4-4.4" />
      </>
    )
  }
  {
    name === "regalo" && (
      <>
        <rect x="4" y="9.5" width="16" height="11" rx="1.2" />
        <path d="M4 13.5h16" />
        <path d="M12 9.5v11" />
        <path d="M12 9.5c-1.2-3.5-3.4-5.5-5-5-1.6.5-1.6 2.7 0 4 1 .8 2.9 1 5 1z" />
        <path d="M12 9.5c1.2-3.5 3.4-5.5 5-5 1.6.5 1.6 2.7 0 4-1 .8-2.9 1-5 1z" />
      </>
    )
  }
  {
    name === "pata" && (
      <>
        <ellipse cx="12" cy="16" rx="4.4" ry="3.6" />
        <circle cx="6.2" cy="9.4" r="1.7" />
        <circle cx="10.6" cy="6.4" r="1.7" />
        <circle cx="15.4" cy="6.4" r="1.7" />
        <circle cx="19.8" cy="9.4" r="1.7" />
      </>
    )
  }
  {
    name === "corazon" && (
      <path d="M12 20.5s-7.5-4.8-9.8-9.4C.6 7.8 2 4.5 5.3 4c2.1-.3 3.9.8 4.7 2.6.8-1.8 2.6-2.9 4.7-2.6 3.3.5 4.7 3.8 3.1 7.1-2.3 4.6-9.8 9.4-9.8 9.4z" />
    )
  }
</svg>
