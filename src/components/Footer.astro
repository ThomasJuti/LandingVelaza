---
import { Picture } from "astro:assets";
import logo from "../assets/velaza-logo.png";
import { waLinkGeneral } from "../data/products";
import IconWhatsApp from "./IconWhatsApp.astro";
import IconInstagram from "./IconInstagram.astro";
---

<footer class="site-footer reveal" id="contacto">
  <div class="footer-logo-wrap">
    <Picture
      src={logo}
      alt="Velaza"
      class="footer-logo"
      width={112}
      height={74}
      densities={[1, 2]}
      formats={["avif", "webp"]}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="footer-tagline">Momentos que dejan huella</div>
  <div class="footer-ctas">
    <a
      href={waLinkGeneral()}
      class="btn btn-whatsapp"
      target="_blank"
      rel="noopener noreferrer"
    >
      <IconWhatsApp size={16} />
      WhatsApp
    </a>
    <a
      href="https://www.instagram.com/velaza.co"
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn-instagram"
    >
      <IconInstagram size={16} />
      @velaza.co
    </a>
  </div>
  <p class="footer-credit">
    Sitio diseñado por <a href="mailto:thomasjuti1210@gmail.com">JUTI</a> ·
    <a
      href="https://www.linkedin.com/in/thomasjutinico/"
      target="_blank"
      rel="noopener noreferrer"
    >
      LinkedIn
    </a>
  </p>
</footer>
