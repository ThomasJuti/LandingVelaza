---
import { Picture, getImage } from "astro:assets";
import { waLinkProducto, type Producto } from "../data/products";
import IconWhatsApp from "./IconWhatsApp.astro";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;

const blurBg = producto.imagen
  ? await getImage({
      src: producto.imagen,
      width: 40,
      height: 30,
      format: "webp",
      quality: 30,
    })
  : null;
---

<div class="card reveal">
  {
    producto.imagen ? (
      <div
        class="card-media"
        style={blurBg ? `--blur-url: url('${blurBg.src}')` : undefined}
      >
        <div class="card-media-bg" aria-hidden="true"></div>
        <Picture
          src={producto.imagen}
          alt={producto.alt}
          class="card-media-fg"
          pictureAttributes={{ class: "card-media-picture" }}
          width={640}
          height={480}
          widths={[320, 480, 640]}
          sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
          formats={["avif", "webp"]}
          quality={78}
          loading="lazy"
          decoding="async"
        />
      </div>
    ) : (
      <div class="card-ph">{producto.ph}</div>
    )
  }
  <div class="card-body">
    <div class="card-cat">{producto.cat}</div>
    <h3 class="card-name">{producto.nombre}</h3>
    <p class="card-desc">{producto.desc}</p>
    <div class="card-prices">
      <div>
        <span class="card-price">{producto.precioU}</span>
        <span class="card-unit">{producto.unidad}</span>
      </div>
      <div class="card-wholesale">
        Al por mayor<br />
        <strong>{producto.precioM}</strong>
      </div>
    </div>
    <a
      href={waLinkProducto(producto)}
      target="_blank"
      rel="noopener noreferrer"
      class="card-cta"
    >
      <IconWhatsApp size={14} />
      Pedir por WhatsApp
    </a>
  </div>
</div>
